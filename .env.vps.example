# Deploy na VPS (docker-compose.yml) — copie para .env ao lado deste arquivo
# e preencha. Só o .env.vps.example fica no git; o .env real nunca é
# versionado (veio do .gitignore).

POSTGRES_USER=erp_inova
POSTGRES_PASSWORD=
POSTGRES_DB=erp_inova
# Porta do host (loopback) por onde dá pra rodar psql direto na VPS.
POSTGRES_PORT=5433

# openssl rand -hex 32
JWT_SECRET=

ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
