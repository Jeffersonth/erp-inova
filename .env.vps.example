# Deploy na VPS (docker-compose.yml) — copie para .env ao lado deste arquivo
# e preencha. Só o .env.vps.example fica no git; o .env real nunca é
# versionado (veio do .gitignore).

POSTGRES_USER=erp_inova
POSTGRES_PASSWORD=
POSTGRES_DB=erp_inova
# Porta do host (loopback) por onde dá pra rodar psql direto na VPS.
POSTGRES_PORT=5433

# Papel de runtime da aplicação (NÃO o POSTGRES_USER — esse é superuser e
# ignora RLS). Criado pela migração 0000. openssl rand -base64 24
APP_DB_PASSWORD=

# openssl rand -hex 32
JWT_SECRET=

ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=

# Só os componentes "use client" que ainda fazem mutação direta ao Supabase
# usam isso (Fase E vai trocar por Server Actions e isso sai daqui). Pegue
# em Project Settings -> API do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
