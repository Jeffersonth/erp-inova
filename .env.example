# Supabase — crie um projeto em https://supabase.com e copie estes valores de
# Project Settings → API. Depois copie este arquivo para .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chaves de servidor (não usar NEXT_PUBLIC — só em Edge Functions / route handlers)
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Fase 2 — assistente IA, geração de rascunhos e resumo diário.
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Fase 4+
# ASAAS_API_KEY=...
