# Banco (Postgres self-hosted na VPS, ver docker-compose.yml). Pra dev local,
# abra um túnel SSH até a VPS: ssh -L 5433:127.0.0.1:5433 root@<ip-da-vps>
DATABASE_URL=postgresql://erp_inova_app:SENHA@127.0.0.1:5433/erp_inova

# Sessão (login próprio — cookie JWT). openssl rand -hex 32
JWT_SECRET=

# Supabase — só o client-side ainda usa (mutações que vão virar Server
# Actions na Fase E); leitura/autenticação server-side já não depende mais
# disso. Remover quando a Fase E terminar.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Fase 2 — assistente IA, geração de rascunhos e resumo diário.
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — assinaturas/MRR reais no Financeiro e Dashboard (chave restrita rk_...).
STRIPE_SECRET_KEY=rk_live_...

# Login Google opcional. Segredos ficam apenas na VPS, nunca no Git.
APP_URL=https://erp.jeffersonthales.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de redirecionamento autorizada no Google Cloud:
# https://erp.jeffersonthales.com/api/auth/google/callback
